VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Multi-tenancy, local. Must match the backend's TENANCY_* values.
# Browsers send every *.localhost name to 127.0.0.1 with no hosts-file entry,
# so master control gets its own host here just like in production:
#   http://admin.localhost:5173   → master control
#   http://{slug}.localhost:5173  → that tenant's app
VITE_TENANCY_BASE_DOMAIN=localhost
VITE_TENANCY_CENTRAL_SUBDOMAIN=admin
