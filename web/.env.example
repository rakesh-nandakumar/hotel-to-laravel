# --- LOCAL DEV ONLY ---
# Where Vite's dev server proxies /api and /sanctum to (see vite.config.ts).
# Must match the scheme+host+port `php artisan serve` actually prints —
# plain http://127.0.0.1:8000 by default. Leave unset and it defaults to
# that same value, so a fresh clone works with no .env at all.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# --- PRODUCTION BUILD ONLY (npm run build) ---
# Absolute origin of the Laravel API. Set this only when the SPA and API live
# on DIFFERENT origins (non-default split-host deploy). No trailing slash.
#
# Leave EMPTY / unset everywhere else — the API is same-origin under /api, so
# VITE_DEV_API_PROXY_TARGET handles local dev and relative paths just work in
# production.
# VITE_API_URL=https://api.example.com

# --- MULTI-TENANCY (production) ---
# Nothing per-domain is baked into the build: the same bundle decides at
# runtime, from the URL prefix, whether it is master control (at
# /{CENTRAL_PREFIX}, default /admin, see backend's TENANCY_CENTRAL_PREFIX) or
# a tenant app (at /{slug}/) — see lib/tenancy.ts. One build serves every
# tenant and the panel on one origin.
#
# Set VITE_TENANCY_CENTRAL_PREFIX only when the backend's
# TENANCY_CENTRAL_PREFIX isn't "admin".
# VITE_TENANCY_CENTRAL_PREFIX=admin

# Realtime uses client-side polling (see src/lib/socket.ts) — no websocket/
# Reverb env is needed on shared cPanel hosting.
