APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Decoupled React SPA — used for CORS + Sanctum's stateful-domain check.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1

# ── MULTI-TENANCY ────────────────────────────────────────────────────────────
# Every tenant is reached at {slug}.{TENANCY_BASE_DOMAIN}; the reserved
# central subdomain below is the master control panel, and the bare base
# domain counts as central too (see App\Http\Middleware\IdentifyTenant).
# Wildcard DNS + wildcard TLS for *.{TENANCY_BASE_DOMAIN} must be provisioned.
# TENANCY_BASE_DOMAIN also drives the wildcard CORS pattern in config/cors.php.
TENANCY_BASE_DOMAIN=vellixglobal.com
TENANCY_CENTRAL_SUBDOMAIN=admin

# ── PRODUCTION (wildcard subdomain tenancy) ──────────────────────────────────
# Serve the SPA and the API from the SAME origin per host (one vhost with an
# /api passthrough). Same-origin keeps Sanctum's cookie session trivial and
# means no per-tenant CORS entry is ever needed.
#   APP_URL=https://vellixglobal.com
#   TENANCY_BASE_DOMAIN=vellixglobal.com
#   SANCTUM_STATEFUL_DOMAINS=*.vellixglobal.com,vellixglobal.com
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax
# And in the SPA build (web/.env):
#   VITE_TENANCY_BASE_DOMAIN=vellixglobal.com
#   VITE_TENANCY_CENTRAL_SUBDOMAIN=admin
#
# !! LEAVE SESSION_DOMAIN UNSET (null) UNDER TENANCY !!
# Setting it to a shared parent (".vellixglobal.com") makes ONE session cookie
# valid on EVERY tenant subdomain — a logged-in user of one tenant would carry
# their session onto another's host. IdentifyTenant catches that and 401s, but
# don't rely on it: unset means the browser scopes each cookie to its own
# host, which is the isolation this architecture assumes. Only set it if the
# SPA and API are on different hosts of a SINGLE tenant (non-tenanted deploy).
#
# If you must split SPA/API across origins, add the API origin explicitly:
#   FRONTEND_URL=https://admin.vellixglobal.com   # plus the wildcard pattern in config/cors.php
# And in the SPA build: VITE_API_URL=https://api.vellixglobal.com

# Shared cPanel can't run a websocket server (Reverb) or a persistent queue
# worker, so realtime uses client-side polling (see web/src/lib/socket.ts) and
# `null` broadcasting means the server never tries to push. Keep these as-is.
BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
# `sync` runs queued jobs (emails/notifications) inline — no worker/cron needed.
QUEUE_CONNECTION=sync

# Reverb is NOT used on shared cPanel. Only fill these (and set
# BROADCAST_CONNECTION=reverb|pusher|ably) if you later move to a host/service
# that supports real websockets.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
