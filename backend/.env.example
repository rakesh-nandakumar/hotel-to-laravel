APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Decoupled React SPA — used for CORS + Sanctum's stateful-domain check.
# The SPA and API share one origin; the SPA is reached at /{slug}/… and the
# API at /api/…. The only extra origin ever needed is the dev Vite server.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1

# ── MULTI-TENANCY (path-prefix over one origin) ─────────────────────────────
# The tenant's identity is the first URL segment: /{slug}/… is that tenant's
# app, /admin/… is master control (see App\Http\Middleware\IdentifyTenant and
# web/src/lib/tenancy.ts). The SPA reads its slug from its own path and sends
# it as X-Tenant-Slug on every API call — one origin, one cookie jar, no
# DNS/wildcard/TLS per tenant.
#   TENANCY_CENTRAL_PREFIX   path prefix that is the master control panel
# TENANCY_BASE_DOMAIN is transitional only: it feeds the Host fallback that
# still serves old {slug}.{base} URLs during cutover (see config/tenancy.php).
# Remove it together with the fallback once nothing arrives by subdomain.
TENANCY_BASE_DOMAIN=
TENANCY_CENTRAL_PREFIX=admin

# ── PRODUCTION (SPA and API on one origin) ──────────────────────────────────
#   APP_URL=https://htl.vellixglobal.com         # SPA + API host
#   FRONTEND_URL=https://htl.vellixglobal.com    # same origin as APP_URL
#   SANCTUM_STATEFUL_DOMAINS=htl.vellixglobal.com
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax
# The SPA needs no tenancy env at all (web/.env): it reads its slug from its
# URL prefix at runtime and sends it as X-Tenant-Slug (see lib/tenancy.ts).
#
# !! LEAVE SESSION_DOMAIN UNSET (null) UNDER TENANCY !!
# One origin means one cookie jar: unset scopes the session cookie to the
# bare host, and IdentifyTenant's cross-tenant guard is what binds a session
# to the tenant the URL names (401, not data bleed). Setting a bare host
# SESSION_DOMAIN is harmless; a shared-parent one is worse than useless.
#
# If you must split SPA/API across origins (VITE_API_URL), add the API origin
# explicitly:
#   FRONTEND_URL=https://htl.vellixglobal.com    # plus the pattern in config/cors.php
# And in the SPA build: VITE_API_URL=https://api.example.com

# Shared cPanel can't run a websocket server (Reverb) or a persistent queue
# worker, so realtime uses client-side polling (see web/src/lib/socket.ts) and
# `null` broadcasting means the server never tries to push. Keep these as-is.
BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
# `sync` runs queued jobs (emails/notifications) inline — no worker/cron needed.
QUEUE_CONNECTION=sync

# Reverb is NOT used on shared cPanel. Only fill these (and set
# BROADCAST_CONNECTION=reverb|pusher|ably) if you later move to a host/service
# that supports real websockets.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
