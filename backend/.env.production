APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:uxaHvfk2lgQj+HeuaxeOY6NUPmOS74TXJ6k6Yi1s0yk=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Wildcard-subdomain multi-tenant deploy: ONE shared document root serves the
# SPA + API for every tenant at {slug}.hms.vellixglobal.com plus the central
# panel at admin.hms.vellixglobal.com. APP_URL must be the BARE base domain.
# Resolution is relative by default; the TENANCY_BASE_DOMAIN pin below is
# strict mode — release:build validates it matches APP_URL and that
# SANCTUM_STATEFUL_DOMAINS covers both this host and the *.{host} wildcard.
APP_URL=https://hms.vellixglobal.com
TENANCY_BASE_DOMAIN=hms.vellixglobal.com
TENANCY_DEV_FALLBACK=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leomclxr_hms
DB_USERNAME=leomclxr_hms_user
DB_PASSWORD=rmsNLxPI,GXzbukQ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Left blank on purpose: each tenant subdomain gets its OWN session cookie,
# scoped only to the exact host that issued it. A shared ".hms.vellixglobal.com"
# cookie would be replayed across tenants by the browser and immediately
# rejected by IdentifyTenant's cross-tenant session check (401), so per-host
# cookies are what you actually want here, not a wider domain.
#
# SANCTUM_STATEFUL_DOMAINS must cover BOTH the bare host (central panel /
# base-domain requests) and the *.{host} wildcard (every tenant subdomain +
# admin.hms.vellixglobal.com) — release:build fails the build if either is
# missing.
FRONTEND_URL=https://hms.vellixglobal.com
SANCTUM_STATEFUL_DOMAINS=hms.vellixglobal.com,*.hms.vellixglobal.com

BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TODO: still a log-only mailer — password reset / email-OTP 2FA will not
# actually deliver until this points at a real SMTP account.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=736980
REVERB_APP_KEY=fju1dp6not3yh93qxtna
REVERB_APP_SECRET=9wgpaf3ror39icq2sxpv
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
