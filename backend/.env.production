APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:uxaHvfk2lgQj+HeuaxeOY6NUPmOS74TXJ6k6Yi1s0yk=
APP_DEBUG=false
APP_TIMEZONE=UTC
# One-origin, path-prefix multi-tenant deploy: ONE shared document root serves
# the SPA + API for every tenant at htl.vellixglobal.com/{slug}/… plus the
# central panel at htl.vellixglobal.com/admin. Tenancy resolves from the
# X-Tenant-Slug header the SPA sends (see config/tenancy.php).
# TENANCY_BASE_DOMAIN is TRANSITIONAL: it feeds the Host fallback that still
# serves old {slug}.htl.vellixglobal.com URLs during cutover (the .htaccess
# 301s page loads to the new prefix). TENANCY_CENTRAL_PREFIX=admin is the
# default and may be omitted. Remove TENANCY_BASE_DOMAIN (and the *.host
# entries, the wildcard DNS, and the fallback code) at cutover.
APP_URL=https://htl.vellixglobal.com
TENANCY_BASE_DOMAIN=htl.vellixglobal.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leomclxr_hms
DB_USERNAME=leomclxr_hms_user
DB_PASSWORD=rmsNLxPI,GXzbukQ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Left blank on purpose: one origin, one session cookie scoped to the bare
# host — every tenant prefix and /admin share the cookie jar, and
# IdentifyTenant's cross-tenant session guard is what binds a session to the
# tenant the URL names (401 on mismatch, never a data bleed). Don't widen it.
#
# SANCTUM_STATEFUL_DOMAINS covers the bare host (the one SPA origin — every
# tenant prefix + /admin). The *.host wildcard stays only while old subdomain
# page loads still arrive during cutover — remove both together.
FRONTEND_URL=https://htl.vellixglobal.com
SANCTUM_STATEFUL_DOMAINS=htl.vellixglobal.com,*.htl.vellixglobal.com

BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=
TENANCY_CENTRAL_PREFIX=admin
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TODO: still a log-only mailer — password reset / email-OTP 2FA will not
# actually deliver until this points at a real SMTP account.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=736980
REVERB_APP_KEY=fju1dp6not3yh93qxtna
REVERB_APP_SECRET=9wgpaf3ror39icq2sxpv
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
