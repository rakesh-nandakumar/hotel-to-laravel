APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:uxaHvfk2lgQj+HeuaxeOY6NUPmOS74TXJ6k6Yi1s0yk=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Single-domain deploy: ONE host serves both the SPA and the API (at /api).
# This is the frontend domain — release:build bakes it in and validates that
# SANCTUM_STATEFUL_DOMAINS / SESSION_DOMAIN below cover this host.
APP_URL=https://demo.hms.vellixglobal.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leomclxr_hms
DB_USERNAME=leomclxr_hms_user
DB_PASSWORD=rmsNLxPI,GXzbukQ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.demo.hms.vellixglobal.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Single-domain deploy: the SPA is served from the SAME host as the API, so
# these just point at that one host. Same-origin means CORS never actually
# fires; SANCTUM_STATEFUL_DOMAINS is what lets Sanctum start the cookie session.
# (release:build validates both cover the APP_URL host.)
FRONTEND_URL=https://demo.hms.vellixglobal.com
SANCTUM_STATEFUL_DOMAINS=demo.hms.vellixglobal.com

BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TODO: still a log-only mailer — password reset / email-OTP 2FA will not
# actually deliver until this points at a real SMTP account.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

