SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Decoupled React SPA — used for CORS + Sanctum's stateful-domain check.
# The SPA and API share one origin; the SPA is reached at /{slug}/… and the
# API at /api/…. The only extra origin ever needed is the dev Vite server.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1

# Multi-tenancy, local — path-prefix over one origin (no subdomains):
#   http://localhost:5173/admin      → master control
#   http://localhost:5173/{slug}/…   → that tenant's app
# The SPA reads its slug from the URL prefix and sends it as X-Tenant-Slug;
# the backend falls back to the Host header while the old {slug}.{base} URL
# style is still in use (see config/tenancy.php). The Vite proxy must leave
# the Host header alone (changeOrigin: false) so central requests still
# resolve the apex host.
TENANCY_CENTRAL_PREFIX=admin

# ── PRODUCTION (SPA and API on one origin) ───────────────────────────────────
#   APP_URL=https://htl.vellixglobal.com        # SPA + API host
#   FRONTEND_URL=https://htl.vellixglobal.com   # same origin
#   SANCTUM_STATEFUL_DOMAINS=htl.vellixglobal.com
#   (TENANCY_BASE_DOMAIN + *.host stateful entries are transitional — the
#    Host fallback serving old subdomain URLs; remove at cutover.)
#   SESSION_SECURE_COOKIE=true                  # HTTPS
#   SESSION_SAME_SITE=lax

# Shared cPanel can't run a websocket server (Reverb) or a persistent queue
# worker, so realtime uses client-side polling (see web/src/lib/socket.ts) and
# `null` broadcasting means the server never tries to push. Keep these as-is.
BROADCAST_CONNECTION="null"
FILESYSTEM_DISK=local
# `sync` runs queued jobs (emails/notifications) inline — no worker/cron needed.
QUEUE_CONNECTION=sync

# Reverb is NOT used on shared cPanel. Only fill these (and set
# BROADCAST_CONNECTION=reverb|pusher|ably) if you later move to a host/service
# that supports real websockets.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
